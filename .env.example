# ===================================================
# KONFIGURASI SISTEM PRESENSI DIGITAL SEKOLAH
# Copy file ini menjadi `.env` lalu sesuaikan nilainya.
# ===================================================

# ---------- Database (PostgreSQL) ----------
# Format: postgresql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE?schema=public
# Bila PostgreSQL ada di VPS yang sama:
DATABASE_URL="postgresql://presensi_user:GANTI_PASSWORD_DISINI@localhost:5432/presensi_sekolah?schema=public"

# Bila memakai cloud (Supabase / Neon / Railway), contoh:
# DATABASE_URL="postgresql://user:password@db.xxxx.supabase.co:5432/postgres?schema=public"

# ---------- Keamanan ----------
# WAJIB diganti dengan string acak panjang (minimal 32 karakter).
# Cara membuat cepat: openssl rand -hex 32
JWT_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter"

# ---------- URL Aplikasi ----------
# Alamat yang dipakai pengguna. Dipakai juga untuk link surat izin di pesan WhatsApp.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Contoh produksi:
# NEXT_PUBLIC_APP_URL="https://presensi.sekolahanda.sch.id"

# ---------- Environment & Port ----------
# "production" di VPS, "development" di komputer lokal
NODE_ENV="production"
# PORT=3000

# ---------- Zona waktu sekolah ----------
# Semua perhitungan jadwal presensi (hari berlaku, buka/tutup sesi,
# batas hadir, jam presensi yang dicatat) dihitung di zona ini,
# BUKAN zona server (VPS default UTC) — agar status di panel admin
# dan "Jadwal Hari Ini" di layar presensi selalu sama & benar.
# WIB = Asia/Jakarta | WITA = Asia/Makassar | WIT = Asia/Jayapura
SCHOOL_TIMEZONE="Asia/Makassar"
TZ="Asia/Makassar"

# ---------- Penyimpanan file (foto, logo, background, bukti izin) ----------
# Biarkan KOSONG untuk VPS: file otomatis disimpan ke `public/uploads`.
# Isi hanya bila deploy di Vercel (menggunakan Vercel Blob).
# BLOB_READ_WRITE_TOKEN=""

# ---------- Google Drive (opsional, arsip surat izin) ----------
# GOOGLE_DRIVE_ENABLED="true"
# GOOGLE_DRIVE_FOLDER_ID="1kk1p30xrosFap-3emPsc2vAemIW3ISG5"
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...isi JSON key...}'
# GOOGLE_SERVICE_ACCOUNT_PATH="/var/www/presensi/service-account.json"
# ---------- Cron Vercel (opsional tetapi disarankan) ----------
# Token ini otomatis dikirim Vercel ke endpoint cleaners jika dibuat di Environment Variables.
# CRON_SECRET="ganti-dengan-token-acak-kron"
