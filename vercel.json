{
  "buildCommand": "npm run db:push && npm run build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["sin1"],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ingress/:path*",
      "destination": "/api/ingress/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/notification-cleanup",
      "schedule": "0 * * * *"
    }
  ]
}
